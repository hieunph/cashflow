rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Người dùng chỉ có quyền đọc/ghi dữ liệu cá nhân của chính mình
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Cho phép đọc/ghi các collection con (transactions, settings, state)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
